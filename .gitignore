scripts/logs/
docs/reports/logs/
docs/reports/visual/
# Phase 4 baseline (M4.0): the full capture and the 2x flagship PNGs stay local; the compact WebP set and the reports are committed
docs/reports/phase-4/baseline/full/
docs/reports/phase-4/baseline/flagship-2x/
test-results/
playwright-report/
blob-report/
.lighthouseci/
coverage/
*.tsbuildinfo

# ---- environment & secrets (never commit)
.env
.env.*
!.env.example
!**/.env.example
!**/.env.production.example
*.keystore
*.jks
*.p8
*.p12
*.pem
*.mobileprovision
google-services.json
GoogleService-Info.plist
# Composer credentials only (a bare `auth.json` also hid web/lang/admin/*/auth.json).
/auth.json
/web/auth.json
/mobile/auth.json
# EAS / Google service-account keys (M2.9 iOS + Play submit)
credentials.json
# Composer credentials above; the auth screens' translations share the name.
!mobile/src/i18n/locales/*/auth.json

