  "material": {
    "chrome": {
      "blur": 24,
      "webBackdrop": "saturate(160%) blur(20px)",
      "androidBlurMinApi": 31,
      "androidMaxBlurViews": 1,
      "iosGlassMaxControls": 2,
      "reducedTransparency": "chrome.opaque",
      "rule": "Glass/translucency only on navigation and floating controls; never on cards, lists or content; never glass on glass. On chrome.translucent text is text.primary or text.secondary only; accent.fg and text.tertiary only as glyphs/indicators (UI 3:1) — they fail 4.5:1 over a white photo.",
      "conflict": "09 §4.1 says blur 24; 09 §4.4 says web backdrop blur(20px). Draft keeps both until an ADR picks one."
    },
    "qrBackdrop": {
      "blur": 16,
      "rule": "SM13: the car behind the QR card stays recognisable as the member's car (ADR-443); plates are already blurred in the photo pipeline, faces never sit behind the card."
    },
    "scrim": {
      "photo": {
        "start": 0.6,
        "end": 1.0,
        "direction": "to bottom",
        "rule": "Photos sit on a dark stage in every theme (ADR-421 b): dark-theme canvas 0 % at 60 % of the height → 100 % at the bottom (Carbon and Hell use the Carbon canvas, Schwarz its black), so in Carbon/Schwarz the hero fades into the canvas. Text over it is onPhoto.* only, and only below the gate's text-safe line (build-tokens --report)."
      },
      "top": {
        "start": 0.0,
        "end": 0.22,
        "direction": "to bottom",
        "rule": "Dark canvas 45 % → 0 % over the top 22 % in every theme: status bar and floating controls; glyphs onPhoto.primary, so the status bar is light over a hero until the header background crossfades in (SM5)."
      }
    },
    "elevation": "Dark themes: tonal surfaces only, no drop shadows. Hell: shadow.light e1/e2/sheet only."
  },
