{
  "meta": {
    "name": "SPEED CLUB Design Tokens",
    "version": "2.0.0",
    "status": "DRAFT for M4.1 (spike) — not the repository file",
    "spec": "docs/09_PREMIUM_2_0.md §4.1–§4.4, §4.7, §4.8, §14.4",
    "source": "Single source of truth. Edit ONLY this file, then run: node design/scripts/build-tokens.mjs",
    "units": "Sizes are density-independent points (RN) = CSS px (web). `tracking` is either a percentage of the font size (\"-1%\") or an absolute pt/px number; build-tokens emits absolute values for every size it writes (mobile and web desktop).",
    "contrastGate": "build-tokens.mjs fails if any required pair is below WCAG 2.2 AA: 4.5:1 text, 3:1 large text (>= 24 px, or >= 18.66 px at 600+) and UI. Every translucent colour is composited explicitly over each base listed in `composite`; a pair with an rgba colour and no declared base is a configuration error, never a skip.",
    "colorRule": "Colour keys are exactly two levels (group.key) so mobile/src/theme/theme.ts ColorToken and resolveColor keep working. Hex for every surface text sits on; rgba only for true translucency. v1 colour values are unchanged (09 §4.1); new roles are added, three v1 roles are superseded (see retired).",
    "retired": {
      "note": "REMOVED in M4.1 (ADR-419 h, ADR-421). build-tokens --check refuses these spellings in consumers (mobile/src, mobile/tests, web/resources, web/tests, web/app, scripts/dev) from M4.1 on: the TypeScript compiler and this scan are the lanes' worklist. Value = replacement; '|' = choose by usage (docs/reports/phase-4/m4.1-token-mapping.md).",
      "typography": {
        "display.xl": "display.title | hero.numeral.s",
        "display.l": "display.title | title.1",
        "display.m": "display.title",
        "title.l": "title.1",
        "title.m": "title.2",
        "title.s": "headline",
        "body.dense": "body",
        "label": "body.strong",
        "label.s": "callout | body.strong (button S)",
        "supporting": "callout",
        "helper": "caption",
        "eyebrow": "label.caps (data labels only) | headline (group headers) | removed",
        "tab": "web.tab (web) | system (NativeTabs)",
        "badge": "label.badge (+ numeric.inline for counts)",
        "spec.strip": "hero.numeral.s | hero.numeral",
        "spec.value": "body.strong + numeric.inline (rows) | hero.numeral* (spec heroes)",
        "spec.unit": "label.unit",
        "code": "headline | body + numeric.inline"
      },
      "font": {
        "display": "numeral | marque"
      },
      "radius": {
        "lg": "md (cards, tiles) | xl (sheets, dialogs, inset hero media)",
        "search": "md"
      },
      "motion": {
        "duration.*": "spring.* (spatial) | effect.* (opacity/colour)",
        "easing.*": "spring.* / effect.* css easing",
        "spring.snappy": "spring.fast",
        "spring.sheet": "spring.default (sheets) | spring.calm (pagers, must not bounce)",
        "spring.hero": "spring.slow",
        "press.opacity": "removed (opacity-only press is banned, DL13): SM7 tone layer in state.pressed (state.pressedInverse on bg.inverse fills)"
      },
      "size": {
        "bubbleRadius": "bubble.radius",
        "bubbleTailRadius": "bubble.tailRadius",
        "chatBubbleMaxWidthRatio": "bubble.maxWidthRatio",
        "tabBarBlur": "material.chrome.blur"
      },
      "layout": {
        "gutter.compact": "removed (phones < 430 use gutter.phone 20)",
        "gutter.regular": "gutter.phone",
        "compactMaxWidth": "phoneLargeMinWidth (threshold moves 390 → 430)"
      },
      "color": {
        "status.success": "state.success",
        "status.warning": "state.warning",
        "status.danger": "accent.fg (text, glyphs) | accent.fill (fills)",
        "status.info": "state.info"
      }
    },
    "deprecated": {
      "note": "STILL PRESENT (values unchanged); consumers migrate in the named module, then the key moves to `retired`. The QA colour whitelist keeps them while they exist.",
      "color": {
        "tabBar.background": {
          "replacement": "chrome.translucent",
          "removeIn": "M4.x navigation (NativeTabs + web tab bar)"
        },
        "overlay.photoScrimEnd": {
          "replacement": "scrim.photoStart → scrim.photoEnd",
          "removeIn": "hero rebuilds M4.8 (HOME-01, AUTH-01) and M4.9 (VEH-01); also config/speedclub.php hero_contrast.scrim_end_alpha and HeroContrast.php (ADR-421 b)"
        }
      },
      "opacity": {
        "pressed": {
          "replacement": "state.pressed overlay / tone shift (never opacity-only)",
          "removeIn": "M4.4 components (5 sites: hoverDim, dim, hidden, cellActive)"
        },
        "photoScrimCoverage": {
          "replacement": "material.scrim.photo",
          "removeIn": "with overlay.photoScrimEnd"
        }
      },
      "aspect": {
        "vehicleHero": {
          "replacement": "aspect.hero (4:5) / aspect.heroWeb (16:9)",
          "removeIn": "vehicle profile module"
        },
        "card": {
          "replacement": "aspect.rail (3:4) / aspect.grid",
          "removeIn": "screen modules"
        }
      }
    }
  },
