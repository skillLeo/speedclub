  "motion": {
    "rule": "Reanimated 4 withSpring with mass 1 passed EXPLICITLY (the installed default mass is 4). damping = 2·ζ·√(stiffness·mass). Bounce only on spatial properties; effects are critically damped. Exits use effect.fast. Admin uses effect.* only (150–200 ms). Reduced motion: spatial → effect.default crossfade; parallax, Ken Burns, stretchy header off; odometer jumps.",
    "spring": {
      "fast": {
        "stiffness": 800,
        "damping": 34,
        "mass": 1,
        "zeta": 0.6,
        "css": {
          "easing": [
            0.42,
            1.67,
            0.21,
            0.9
          ],
          "duration": 350
        },
        "use": "press, toggles, chips, picker pops"
      },
      "default": {
        "stiffness": 380,
        "damping": 31,
        "mass": 1,
        "zeta": 0.8,
        "css": {
          "easing": [
            0.38,
            1.21,
            0.22,
            1.0
          ],
          "duration": 500
        },
        "use": "sheets, hero expand, tab content, row expand"
      },
      "slow": {
        "stiffness": 200,
        "damping": 23,
        "mass": 1,
        "zeta": 0.8,
        "css": {
          "easing": [
            0.39,
            1.29,
            0.35,
            0.98
          ],
          "duration": 650
        },
        "use": "full-screen reveals: splash, QR, onboarding"
      },
      "calm": {
        "stiffness": 700,
        "damping": 48,
        "mass": 1,
        "zeta": 0.9,
        "css": {
          "easing": [
            0.2,
            0,
            0,
            1
          ],
          "duration": 300
        },
        "use": "navigation, lists, pagers — anything that must not bounce"
      }
    },
    "effect": {
      "fast": {
        "stiffness": 3800,
        "damping": 123,
        "mass": 1,
        "zeta": 1.0,
        "css": {
          "easing": [
            0.31,
            0.94,
            0.34,
            1.0
          ],
          "duration": 150
        },
        "use": "opacity/colour, exits"
      },
      "default": {
        "stiffness": 1600,
        "damping": 80,
        "mass": 1,
        "zeta": 1.0,
        "css": {
          "easing": [
            0.34,
            0.8,
            0.34,
            1.0
          ],
          "duration": 200
        },
        "use": "skeleton → content, crossfades, reduced-motion replacement"
      },
      "slow": {
        "stiffness": 800,
        "damping": 57,
        "mass": 1,
        "zeta": 1.0,
        "css": {
          "easing": [
            0.34,
            0.88,
            0.34,
            1.0
          ],
          "duration": 300
        },
        "use": "large crossfades, theme change"
      }
    },
    "stagger": {
      "s": 30,
      "m": 60,
      "rule": "small groups at brand moments only; never list items on mount"
    },
    "press": {
      "scale": 0.97,
