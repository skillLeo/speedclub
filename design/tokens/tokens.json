  "accentPalette": {
    "note": "Admin may switch the accent ONLY to one of these pre-validated sets (ADM-28). Each set is contrast-checked by build-tokens.mjs on all three themes. 2.0: `bubbleOwnBg` is the set's own-bubble tint (OKLCH L 0.30 C<=0.09 dark / L 0.93 C 0.03 light at the set's fill hue, chroma clamped to sRGB); theme.ts must route it to color.bubble.ownBg, not color.accent.",
    "default": "signalRed",
    "sets": {
      "signalRed": {
        "label": "Signal Red",
        "dark": {
