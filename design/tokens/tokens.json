  "composite": {
    "note": "Every rgba colour with the opaque bases it is drawn over. `photo.light`/`photo.dark` are the worst-case photo pixels (any photo can contain pure white or pure black). The gate composites source-over in sRGB, unrounded.",
    "bases": {
      "photo.light": "#FFFFFF",
      "photo.dark": "#000000"
    },
    "tokens": {
      "border.hairline": [
        "bg.canvas",
        "bg.surface",
        "bg.raised",
        "bg.overlay"
      ],
      "state.hover": [
        "bg.canvas",
        "bg.surface",
        "bg.raised",
        "bg.overlay"
      ],
      "state.pressed": [
        "bg.canvas",
        "bg.surface",
        "bg.raised",
        "bg.overlay"
      ],
      "state.pressedInverse": [
        "bg.inverse"
      ],
      "state.selected": [
        "bg.canvas",
        "bg.surface",
        "bg.raised",
        "bg.overlay"
      ],
      "overlay.scrim": [
        "bg.canvas",
        "bg.surface",
        "photo.light",
        "photo.dark"
      ],
      "overlay.photoScrimEnd": [
        "photo.light",
        "photo.dark"
      ],
      "scrim.photoStart": [
        "photo.light",
        "photo.dark"
      ],
      "scrim.topStart": [
        "photo.light",
        "photo.dark"
      ],
      "scrim.topEnd": [
        "photo.light",
        "photo.dark"
      ],
      "chrome.translucent": [
        "bg.canvas",
        "scrim.photoEnd",
        "photo.light",
        "photo.dark"
      ],
      "avatar.innerBorder": [
        "photo.light",
        "photo.dark"
      ],
      "tabBar.background": [
        "bg.canvas",
        "photo.light",
        "photo.dark"
      ],
      "onPhoto.secondary": [
        "photo.light",
        "photo.dark"
      ],
      "onPhoto.border": [
        "photo.light",
        "photo.dark"
      ],
      "onPhoto.chipBg": [
        "photo.light",
        "photo.dark"
      ]
    }
  },
