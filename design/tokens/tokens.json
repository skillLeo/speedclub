  "meta": {
    "name": "SPEED CLUB Design Tokens",
    "version": "1.0.0",
    "source": "Single source of truth. Edit ONLY this file, then run: node design/scripts/build-tokens.mjs",
    "units": "All sizes are density-independent points (RN) = CSS px (web). Letter spacing is absolute (pt/px), not em.",
    "contrastGate": "build-tokens.mjs fails if any required colour pair is below WCAG 2.x thresholds (text 4.5:1, UI 3:1)."
