  "themeOrder": [
    "carbon",
    "black",
    "light"
  ],
  "defaultTheme": "carbon",
  "systemMapping": {
    "dark": "carbon",
    "light": "light"
  },
  "accentPalette": {
    "note": "Admin may switch the accent ONLY to one of these pre-validated sets (ADM-28). Each set is contrast-checked by build-tokens.mjs on all three themes.",
    "default": "signalRed",
    "sets": {
      "signalRed": {
        "label": "Signal Red",
        "dark": {
          "fg": "#EC5A5F",
          "fill": "#C8102E",
          "fillPressed": "#A90D27"
        },
        "light": {
          "fg": "#C8102E",
          "fill": "#C8102E",
          "fillPressed": "#A90D27"
        }
      },
      "emberOrange": {
        "label": "Ember Orange",
        "dark": {
          "fg": "#F0884A",
          "fill": "#B4470C",
          "fillPressed": "#963A09"
        },
        "light": {
          "fg": "#A8420B",
          "fill": "#B4470C",
          "fillPressed": "#963A09"
        }
      },
      "racingBlue": {
        "label": "Racing Blue",
        "dark": {
          "fg": "#6EA8FE",
          "fill": "#1F5FBF",
          "fillPressed": "#1A4FA0"
        },
        "light": {
          "fg": "#1F5FBF",
          "fill": "#1F5FBF",
          "fillPressed": "#1A4FA0"
        }
      },
      "pitGreen": {
        "label": "Pit Green",
        "dark": {
          "fg": "#4CC38A",
          "fill": "#1A7347",
          "fillPressed": "#145C39"
        },
        "light": {
          "fg": "#1A7347",
          "fill": "#1A7347",
          "fillPressed": "#145C39"
        }
      }
    }
  },
  "shadow": {
    "light": {
      "e1": {
        "x": 0,
        "y": 1,
        "blur": 2,
        "spread": 0,
        "color": "rgba(0,0,0,0.06)"
      },
      "e2": {
        "x": 0,
        "y": 4,
        "blur": 12,
        "spread": 0,
        "color": "rgba(0,0,0,0.08)"
      },
      "sheet": {
        "x": 0,
        "y": -8,
        "blur": 24,
        "spread": 0,
        "color": "rgba(0,0,0,0.12)"
      }
    },
    "dark": "none — dark themes express elevation with bg.surface → bg.raised → bg.overlay steps"
  },
  "font": {
    "ui": {
      "css": "'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
      "native": {
        "400": "Inter_400Regular",
        "500": "Inter_500Medium",
        "600": "Inter_600SemiBold",
        "700": "Inter_700Bold"
      },
      "packages": {
        "expo": "@expo-google-fonts/inter",
        "web": "@fontsource/inter"
      }
    },
    "display": {
      "css": "'Barlow Semi Condensed', 'Arial Narrow', 'Inter', sans-serif",
      "native": {
        "500": "BarlowSemiCondensed_500Medium",
        "600": "BarlowSemiCondensed_600SemiBold",
        "700": "BarlowSemiCondensed_700Bold"
      },
      "packages": {
        "expo": "@expo-google-fonts/barlow-semi-condensed",
        "web": "@fontsource/barlow-semi-condensed"
      }
    }
  },
