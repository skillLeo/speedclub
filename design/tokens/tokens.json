      "decelerate": [
        0.05,
        0.7,
        0.1,
        1
      ],
      "accelerate": [
        0.3,
        0,
        0.8,
        0.15
      ]
    },
    "spring": {
      "snappy": {
        "damping": 26,
        "stiffness": 380,
        "mass": 1
      },
      "sheet": {
        "damping": 30,
        "stiffness": 300,
        "mass": 1,
        "overshootClamping": true
      },
      "hero": {
        "damping": 24,
        "stiffness": 200,
        "mass": 1
      }
    },
    "press": {
      "scale": 0.98,
      "opacity": 0.92
    },
    "rules": "Exits ~20% faster than entrances. Overshoot ≤2%. Nothing loops except skeleton shimmer (off with reduced motion). Animate transform/opacity only."
