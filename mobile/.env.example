# Only EXPO_PUBLIC_* values may exist here: they are inlined into the app bundle and are not secret.
# Web export talks to its own origin, so EXPO_PUBLIC_API_URL stays empty for the member web.
EXPO_PUBLIC_APP_ENV=local
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_WEB_URL=
EXPO_PUBLIC_PUSHER_KEY=
EXPO_PUBLIC_PUSHER_CLUSTER=eu
# M4.6 sign-in providers on the member web (owner actions OA-38 / OA-26). Public identifiers, not secrets; empty keeps the
# provider unavailable. Apple: the Services ID and its return URL as registered with Apple. Google: the OAuth web client ID.
EXPO_PUBLIC_APPLE_SERVICES_ID=
EXPO_PUBLIC_APPLE_REDIRECT_URI=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
