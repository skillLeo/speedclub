    "@react-native-community/netinfo": "12.0.1",
    "@shopify/flash-list": "2.3.2",
    "@tanstack/query-async-storage-persister": "^5.105.1",
    "@tanstack/react-query": "^5.105.1",
    "@tanstack/react-query-persist-client": "^5.105.1",
    "date-fns": "^4.4.0",
    "expo": "~58.0.22",
    "expo-application": "~58.1.2",
    "expo-blur": "~58.0.5",
    "expo-build-properties": "~58.0.12",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.18",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.15",
    "expo-local-authentication": "~58.0.3",
    "expo-localization": "~58.0.5",
    "expo-navigation-bar": "~58.0.4",
    "expo-network": "~58.0.4",
    "expo-notifications": "~58.1.7",
    "expo-router": "~58.0.29",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.21",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.7",
    "i18next": "^26.7.1",
    "laravel-echo": "^2.6.3",
    "openapi-fetch": "^0.17.0",
    "phosphor-react-native": "^3.0.6",
    "pusher-js": "^8.6.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.91.0",
    "react-i18next": "^17.1.11",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^58.0.4",
    "eslint-plugin-react-native": "^5.0.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.13",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "test-renderer": "^1.3.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "jest",
    "i18n:check": "node scripts/check-i18n.mjs",
    "design-lint": "node ../scripts/design-lint.mjs --root ..",
    "verify": "npm run typecheck && npm run lint && jest --ci && npm run i18n:check && npm run design-lint",
    "export:web": "node scripts/export-web.mjs",
    "api:types": "openapi-typescript ../docs/api/openapi.json -o src/api/schema.d.ts"
  },
  "private": true,
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  },
  "jest": {
    "preset": "jest-expo",
    "roots": [
      "<rootDir>/tests"
    ],
    "moduleNameMapper": {
      "^@/assets/(.*)$": "<rootDir>/assets/$1",
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "setupFiles": [
      "<rootDir>/tests/setup.ts"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|react-navigation|@react-navigation/.*|@shopify/flash-list|phosphor-react-native|react-native-svg|standard-navigation)"
    ],
    "resolver": "react-native-reanimated/jest/resolver",
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setupAfterEnv.ts"
    ]
  }
}
