# Local development. Copy to .env and run: php artisan key:generate
# Every key of 05_ARCHITECTURE §20 is documented here. Never commit real values.

APP_NAME="SPEED CLUB"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
# Other hosts that may reach the app, comma separated (e.g. www.example.de). Everything else gets a 404 outside local.
TRUSTED_HOSTS=
# Behind a host's TLS proxy: its IPs or CIDR ranges, comma separated, or * only if nothing can reach PHP around the proxy
# (X-Forwarded-For would be spoofable otherwise). Empty trusts no proxy, so HTTPS looks like HTTP behind one.
TRUSTED_PROXIES=
# Redirect plain HTTP to APP_URL (production with an https APP_URL only). Turn on after checking the host:
# curl -I http://your-host/ must reach PHP directly. Requests carrying X-Forwarded-Proto are never redirected.
FORCE_HTTPS=false

APP_LOCALE=de
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=de_DE

APP_MAINTENANCE_DRIVER=file

# Without HASH_DRIVER: argon2id where PHP has it, otherwise bcrypt (config/hashing.php).
# HASH_DRIVER=argon2id
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# daily keeps LOG_DAILY_DAYS files and removes older ones. The privacy policy promises 14 days; "single" never rotates.
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
# debug locally, warning on servers
LOG_LEVEL=debug

# MySQL 8+ or MariaDB 10.6+ in production
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=speedclub
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Seconds a staff password confirmation stays valid (06_ADMIN_SPEC §1: 5 minutes).
AUTH_PASSWORD_TIMEOUT=300
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Unset: follows APP_URL (https means secure cookies)
SESSION_SECURE_COOKIE=false
# Hosts that get cookie sessions on /api (SPA at /app and the Expo web dev server)
SANCTUM_STATEFUL_DOMAINS=localhost:8080,127.0.0.1:8080,localhost:8081
# Browser origins allowed by CORS (comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8080

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Realtime (M2.4): Pusher Channels, EU cluster. On only when all four PUSHER_* values are set; otherwise nothing is broadcast and the
# apps poll (3 s thread, 15 s inbox). BROADCAST_CONNECTION=log or null keeps it off even with keys. The key and cluster are public
# (GET app-config realtime); the secret and app id never leave the server.
BROADCAST_CONNECTION=log
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=eu

# log locally, smtp on servers
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@speedclub.test"
MAIL_FROM_NAME="SPEED CLUB"

# public | s3 (S3-compatible EU bucket)
MEDIA_DISK=public
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-central-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Push through the Expo Push API (M2.2). Off: nothing is sent, in-app notifications and e-mails still work.
# Needs the Expo project id and FCM V1 credentials uploaded to Expo first (owner action).
PUSH_ENABLED=false
# Optional: only when "enhanced push security" is on in the Expo project
EXPO_ACCESS_TOKEN=

# Reference time of Home's windows and ranking (App\Support\HomeClock). Unset locally: the demo's NOW (DemoSeeder::NOW), so the demo
# looks alive and the visual matrix stays deterministic. Empty value: the real now. Staging and production leave it empty.
# HOME_CLOCK=

# Where security mails send members who did not make a change themselves (default support@speedclub.de)
# SUPPORT_EMAIL=support@speedclub.de

# Optional: AI features behind flags (OA-18). Without a provider and its key every ai.* flag stays off.
AI_PROVIDER=
ANTHROPIC_API_KEY=
# AI_MODEL=claude-haiku-5-5
# AI_TIMEOUT=8

# Optional: Cloudflare Turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Search engines. Unset: allowed, except on APP_ENV=staging. Off means robots.txt forbids everything and every page says noindex.
# ALLOW_INDEXING=true

# Admin portal
ADMIN_IP_ALLOWLIST=
ADMIN_DOMAIN=
STAFF_OWNER_EMAIL=owner@speedclub.test

# Deep links (assetlinks.json, apple-app-site-association) and store badges
ANDROID_PACKAGE=de.speedclub.app
# SHA-256 of the signing key, with or without colons; several comma separated (upload key and Play's app signing key).
# Current upload key (Mac, since 2026-11-07, OA-8): 95:EF:80:0D:F2:D5:D9:2B:0F:8C:A9:C9:DE:D0:B7:1B:F9:6B:0B:82:38:92:84:B2:1E:8E:24:86:30:02:F0:79
ANDROID_CERT_SHA256=
IOS_TEAM_ID=
IOS_BUNDLE_ID=de.speedclub.app
STORE_URL_IOS=
STORE_URL_ANDROID=
# Slug of the build on the landing page. Empty: the public vehicle with the most mods.
FEATURED_VEHICLE_SLUG=
# Featured builds of Start (HOME-01), comma-separated slugs or public ids, in order. Empty: the most complete public builds.
HOME_FEATURED_SLUGS=

# Optional
SENTRY_LARAVEL_DSN=

# Health check e-mails
HEALTH_NOTIFICATIONS_ENABLED=false
HEALTH_TO_ADDRESS=

# Local and staging seeders only
DEMO_MEMBER_PASSWORD=
DEMO_STAFF_PASSWORD=
DEMO_SEED_ON_STAGING=false
DEMO_PHOTO_LIMIT=60

VITE_APP_NAME="${APP_NAME}"

# QA only, never in production: the user agent the e2e harness signs in with. DemoSeeder stores it as a known device of
# every demo member, so QA runs write no "new device" security rows (ADR-199 j). Default: SpeedClubQA/1.0 (Playwright).
# QA_USER_AGENT=

# M2.7 WEB-04 /app-laden: the tester APK on a staging host (leave empty in production)
TESTER_APK_URL=
TESTER_APK_SHA256=

# Backups (spatie/laravel-backup, ADR-250, DEPLOY §12). The archive is AES-256 encrypted with this password; keep it in the password manager.
BACKUP_ARCHIVE_PASSWORD=
# Failure mails; empty = HEALTH_TO_ADDRESS, else SUPPORT_EMAIL.
BACKUP_MAIL_TO=
BACKUP_DISK=backups
# Archive folder; empty = storage/app/backups (outside public/ and outside the backed-up folders).
BACKUP_DISK_ROOT=
BACKUP_NAME=speedclub
BACKUP_MAX_MEGABYTES=5000
# MySQL with GTIDs on (`select @@gtid_mode` = ON): OFF, or a restore fails with ERROR 3546. Leave empty on MariaDB.
DB_DUMP_GTID_PURGED=
# A host that disables proc_open (Hostinger and other shared hosts; the doctor says so): the cron runs
# `php artisan speedclub:schedule-inline` instead of schedule:run, and this is true (DEPLOY.md §5).
SCHEDULER_INLINE=false
# AI (ADR-252): each member may use this share of a feature's daily budget, at least the minimum.
AI_MEMBER_DAILY_SHARE=0.02
AI_MEMBER_DAILY_MIN=20
# Address reveals per staff member and day (SEC-P3-21).
STAFF_PII_REVEALS_PER_DAY=200
