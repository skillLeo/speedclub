# SPEED CLUB on shared hosting (staging or production). Copy to .env on the server (chmod 600), fill in, then follow docs/DEPLOY.md.
# Every key the app reads in production is listed here (05_ARCHITECTURE §20, config/*.php). Never commit real values, never paste
# this file's filled-in copy into a chat or ticket. After any change: php artisan config:cache (or optimize).
# Keys left out fall back to the framework defaults in config/*.php, which are the right ones for a shared host.

# --- Application -------------------------------------------------------------------------------------------------------------
APP_NAME="SPEED CLUB"
# staging (client test host: robots.txt forbids everything, /docs/api open, demo seed possible) | production (live site)
APP_ENV=production
# Generated once by `php artisan key:generate --force` on the first deploy. Never regenerate on a live site: it signs everyone out,
# breaks signed chat-photo URLs and every encrypted column (2FA secrets, AI translation cache).
APP_KEY=
# Only for a planned key rotation: the old key(s), comma separated, so existing data stays readable.
APP_PREVIOUS_KEYS=
APP_DEBUG=false
# The public origin, https only. Links in mails, the staff reset link (unless ADMIN_DOMAIN) and the storage URL derive from it.
APP_URL=https://speedclub.de
# Other host names that may reach the app, comma separated (e.g. www.speedclub.de). ADMIN_DOMAIN is added automatically. Others: 404.
TRUSTED_HOSTS=
# Behind a TLS proxy of the host: its IPs or CIDR ranges, comma separated. Empty trusts no proxy (then HTTPS looks like HTTP behind one).
# Do NOT use * when ADMIN_IP_ALLOWLIST is set: the admin fence then ignores forwarded headers and sees only the proxy (ADR-231).
TRUSTED_PROXIES=
# Redirect plain HTTP to APP_URL. Works only with APP_ENV=production and an https APP_URL. Turn on after checking that
# `curl -I http://<domain>/` reaches PHP directly. Requests carrying X-Forwarded-Proto and /up are never redirected (ADR-126).
FORCE_HTTPS=false
# Search engines. Unset: allowed in production, forbidden on APP_ENV=staging. false: robots.txt forbids everything + noindex.
# ALLOW_INDEXING=true

APP_LOCALE=de
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=de_DE
APP_MAINTENANCE_DRIVER=file

# Unset: argon2id where PHP has it (recommended), otherwise bcrypt.
# HASH_DRIVER=argon2id
BCRYPT_ROUNDS=12

# --- Logs (the privacy policy promises 14 days) ------------------------------------------------------------------------------
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null

# --- Database (MySQL 8 or MariaDB >= 10.6, an empty database with its own user) ----------------------------------------------
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# --- Sessions, cookies, CORS -------------------------------------------------------------------------------------------------
SESSION_DRIVER=database
# Member web session in minutes. The staff session is fixed at 30 minutes, sliding, on the cookie path /admin (ADR-217).
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
# Empty = the exact host of the request. Do not set a parent domain (".speedclub.de"): the cookie would reach every subdomain.
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true
# Seconds a staff password confirmation stays valid for sensitive admin actions (06_ADMIN_SPEC §1: 5 minutes, ADR-215).
AUTH_PASSWORD_TIMEOUT=300
# Hosts that get cookie sessions on /api (the member web at /app): the bare host name of APP_URL, plus www if used.
SANCTUM_STATEFUL_DOMAINS=speedclub.de
# Browser origins allowed by CORS, comma separated: the APP_URL origin (plus www if used).
CORS_ALLOWED_ORIGINS=https://speedclub.de

# --- Cache, queue, files -----------------------------------------------------------------------------------------------------
# Database cache and queue: no Redis, no daemon. The queue runs from cron (routes/console.php, last entry).
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
# Public media (photos, OG cards): public = storage/app/public behind the storage link; s3 = an S3-compatible EU bucket.
MEDIA_DISK=public
# Private files (chat photos, data exports, photo originals, report evidence, audit exports): always local = storage/app/private.
MEDIA_PRIVATE_DISK=local
# Only with MEDIA_DISK=s3:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-central-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Mail (OA-16). SPF + DKIM for the sender domain, otherwise codes land in spam ---------------------------------------------
MAIL_MAILER=smtp
# smtps + 465, or smtp + 587 (STARTTLS)
MAIL_SCHEME=smtps
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
# An address on your own domain.
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="SPEED CLUB"

# Where security mails send members who did not make a change themselves, and the contact form (WEB-10). Commented out: support@speedclub.de
# (an empty value would be used as an empty address, so set a real one or leave the line commented out).
# SUPPORT_EMAIL=support@speedclub.de
# Notices and appeals by e-mail (DSA notice-and-action, ADR-116; the [[Melde-E-Mail]] of the legal texts). Unset: SUPPORT_EMAIL.
# MODERATION_EMAIL=moderation@speedclub.de
# Certified out-of-court dispute settlement body (Art. 21 DSA) named in statements of reasons. Leave the line commented out for the
# default (the European Commission's DSA page, OA-17). An empty value removes the link.
# DISPUTE_SETTLEMENT_URL=

# --- Realtime messaging (OA-13): Pusher Channels, EU cluster ----------------------------------------------------------------
# On only when BROADCAST_CONNECTION=pusher and id, key and secret are set (ADR-201). Without them the apps poll (3 s thread, 15 s
# inbox) and the CSP stays connect-src 'self'. In the Pusher dashboard keep "subscription counting" and client events off.
BROADCAST_CONNECTION=pusher
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=eu

# --- Push (OA-14): Expo Push API --------------------------------------------------------------------------------------------
# true once the Expo project exists and its FCM V1 key (Android) and APNs key (iOS) are uploaded to Expo.
PUSH_ENABLED=false
# Recommended for production (SEC-P2-14): turn on "Enhanced push security" in the Expo project and put an Expo access token here.
# Without it, anyone who learns a device's push token could send it pushes. With the setting on and no token, every push fails.
EXPO_ACCESS_TOKEN=

# --- Web Push of the member web (OA-32, ADR-452) -----------------------------------------------------------------------------
# One VAPID key pair per host, from `php artisan speedclub:web-push-keys` (prints the pair, never writes .env). Keep it for good: a
# new pair cuts off every subscribed browser until the member turns notifications on again. The public key reaches browsers through
# app-config; the private key never leaves the server. The subject is the push services' contact (mailto:… or https://…). All
# three empty: no browser notifications, and the member web hides the option. The flag web_push switches delivery on top.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=

# --- AI features (optional, OA-18) -----------------------------------------------------------------------------------------
# Both AI_PROVIDER and that provider's key are needed; otherwise every AI endpoint answers 404 feature_disabled and no ai.* flag
# can be switched on in the admin (ADR-242). After setting them, switch features on in Admin → Feature-Flags (ADM-36).
# Provider: anthropic (default choice, ADR-030) | openai | gemini | mistral. Check the provider's data-processing terms and region.
AI_PROVIDER=
ANTHROPIC_API_KEY=
# Only for another provider:
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# MISTRAL_API_KEY=
# Model and timeout (seconds, one retry). Defaults: claude-haiku-5-5, 8.
# AI_MODEL=claude-haiku-5-5
# AI_TIMEOUT=8
# Provider calls per feature and day (Europe/Berlin) across all members; above it the feature answers "ausgelastet". Defaults:
# AI_DAILY_NL_SEARCH=2000
# AI_DAILY_MOD_ASSIST=1000
# AI_DAILY_PHOTO_TAGGING=2000
# AI_DAILY_TRANSLATE=3000
# AI_DAILY_DESCRIPTION_ASSIST=500
# AI_DAILY_MODERATION_TRIAGE=2000

# --- Abuse protection (recommended on any public host) ---------------------------------------------------------------------
# Cloudflare Turnstile for /melden, /kontakt, /konto-loeschen (the CSP then allows challenges.cloudflare.com). Without keys: rate limits only.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# --- Admin portal (/admin) ----------------------------------------------------------------------------------------------------
# Enforced on every staff route, sign-in included: other clients get a plain 404. IPv4/IPv6 addresses or CIDR ranges, comma
# separated (e.g. the office's fixed IP and a VPN range). Strongly recommended in production. See TRUSTED_PROXIES above.
ADMIN_IP_ALLOWLIST=
# Optional separate host for the admin (e.g. admin.speedclub.de, needs its own DNS + certificate pointing at the same public/).
# Only routing and cookie separation: it is NOT an access control (anyone can send that Host header). Empty: /admin on APP_URL.
ADMIN_DOMAIN=
# The first Owner, created by `php artisan db:seed --force` with an unknown random password and "password proof required". The
# Owner sets the password through "Passwort vergessen?" on /admin/login, then must enrol TOTP. Later staff are invited in ADM-39.
STAFF_OWNER_EMAIL=

# --- Seeders: staging only, never in production ----------------------------------------------------------------------------
# DemoSeeder needs fakerphp/faker, a dev dependency the package does not contain. Keep all of these empty / false.
DEMO_SEED_ON_STAGING=false
# A set DEMO_STAFF_PASSWORD on staging creates one demo staff account per role with that shared password: keep it empty.
DEMO_STAFF_PASSWORD=
DEMO_MEMBER_PASSWORD=

# --- App links, store badges, landing ---------------------------------------------------------------------------------------
ANDROID_PACKAGE=de.speedclub.app
# SHA-256 of the APK signing certificate(s), with or without colons; several comma separated (upload key, and Play's app signing
# key once the app is on Google Play). Current upload key (since 2026-11-07, HANDOFF OA-8):
# 95:EF:80:0D:F2:D5:D9:2B:0F:8C:A9:C9:DE:D0:B7:1B:F9:6B:0B:82:38:92:84:B2:1E:8E:24:86:30:02:F0:79
ANDROID_CERT_SHA256=
# Apple Developer Team ID (OA-15). Without it apple-app-site-association lists no app and iOS universal links stay off.
IOS_TEAM_ID=
IOS_BUNDLE_ID=de.speedclub.app
# Store listings once published (badges on the public pages and SYS-01 "Update erforderlich").
# M4.9: the external sticker shop (QR-03 "Sticker bestellen"), empty = no link; the flag sticker_shop switches it on.
STICKER_SHOP_URL=
STORE_URL_IOS=
STORE_URL_ANDROID=
# Slug of the build on the landing page. Empty: the public vehicle with the most mods.
FEATURED_VEHICLE_SLUG=
# Featured builds of Start (HOME-01), comma-separated slugs or public ids, in order. Empty: the most complete public builds.
# (The admin's home curation, ADM-33, takes precedence once used.)
HOME_FEATURED_SLUGS=
# Reference time of Home's ranking windows. MUST stay empty on every host (the real now); a value freezes Home.
HOME_CLOCK=

# --- Staging only: the tester APK on /app-laden (WEB-04). Empty in production ------------------------------------------------
TESTER_APK_URL=
# 64 hex digits, the .sha256 file of build-apk.ps1
TESTER_APK_SHA256=

# --- Monitoring ---------------------------------------------------------------------------------------------------------------
# spatie/laravel-health mails failed checks (cron heartbeat, queue, disk, database) to this address.
HEALTH_NOTIFICATIONS_ENABLED=true
HEALTH_TO_ADDRESS=
# Optional error tracking (server side only).
SENTRY_LARAVEL_DSN=

# --- Backups (spatie/laravel-backup, docs/DEPLOY.md §12) -----------------------------------------------------------------------
# Password for the backup zip (AES-256). Strongly recommended: the archive holds the database and the uploaded photos.
# Keep a copy of it outside the server (password manager), or the backups cannot be restored.
BACKUP_ARCHIVE_PASSWORD=
# Backup failure mails (empty = HEALTH_TO_ADDRESS, else SUPPORT_EMAIL), disk and size cap (ADR-250).
BACKUP_MAIL_TO=
BACKUP_DISK=backups
# Archive folder; empty = storage/app/backups (outside public/ and outside the backed-up folders).
BACKUP_DISK_ROOT=
BACKUP_NAME=speedclub
BACKUP_MAX_MEGABYTES=5000
# MySQL with GTIDs on (`select @@gtid_mode` = ON): OFF, or a restore fails with ERROR 3546. Leave empty on MariaDB.
DB_DUMP_GTID_PURGED=
# A host that disables proc_open (Hostinger and other shared hosts; the doctor says so): the cron runs
# `php artisan speedclub:schedule-inline` instead of schedule:run, and this is true (DEPLOY.md §5).
SCHEDULER_INLINE=false
# AI per-member share of a feature's daily budget (ADR-252); only matters once an AI provider is configured (OA-18).
AI_MEMBER_DAILY_SHARE=0.02
AI_MEMBER_DAILY_MIN=20
# Address reveals per staff member and day (SEC-P3-21).
STAFF_PII_REVEALS_PER_DAY=200

# M4.12 geocoding proxy (ADR-411): a contact address for Nominatim's usage policy (owner action OA, set before events.create is on).
GEOCODE_CONTACT_EMAIL=

# Content Security Policy: on by default. Never switch it off on a public host.
# CSP_ENABLED=true

VITE_APP_NAME="${APP_NAME}"
