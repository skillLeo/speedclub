{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "speedclub/web",
    "type": "project",
    "description": "SPEED CLUB - Laravel 13 monolith (API, admin, public pages, SPA host)",
    "keywords": [
        "speedclub"
    ],
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "ext-intl": "*",
        "barryvdh/laravel-dompdf": "^3.1",
        "chillerlan/php-qrcode": "^6.0",
        "dedoc/scramble": "^0.13.52",
        "dompdf/php-font-lib": "^1.0",
        "firebase/php-jwt": "^7.2",
        "inertiajs/inertia-laravel": "^3.0",
        "intervention/image": "^4.0",
        "kornrunner/blurhash": "^1.2",
        "laravel/ai": "^1.3",
        "laravel/fortify": "^1.41",
        "laravel/framework": "^13.0",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^3.0",
        "league/flysystem-aws-s3-v3": "^3.35",
        "pragmarx/google2fa": "^9.1",
        "pusher/pusher-php-server": "^7.3",
        "spatie/laravel-backup": "^10.3",
        "spatie/laravel-csp": "^3.30",
        "spatie/laravel-health": "^1.40",
        "spatie/laravel-permission": "^8.3",
        "spatie/laravel-query-builder": "^7.3",
        "spatie/laravel-sitemap": "^8.0",
        "spatie/laravel-translatable": "^6.14",
        "spatie/simple-excel": "^3.11",
        "tightenco/ziggy": "^2.6"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.13",
        "laravel/pail": "^1.2.5",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^4.7",
        "pestphp/pest-plugin-laravel": "^4.1",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "verify": [
            "Composer\\Config::disableProcessTimeout",
            "@php vendor/bin/pint --test",
            "@php vendor/bin/phpstan analyse --no-progress --memory-limit=1G",
            "@php vendor/bin/pest --parallel",
            "@composer audit"
        ],
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1 --timeout=0\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "platform": {
            "php": "8.3.0"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
