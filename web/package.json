{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "typecheck": "vue-tsc --noEmit",
        "lint": "eslint resources/js --max-warnings 0",
        "i18n:admin": "node scripts/check-admin-i18n.mjs",
        "design-lint": "node ../scripts/design-lint.mjs --root ..",
        "verify": "npm run typecheck && npm run lint && npm run i18n:admin && npm run build && npm run design-lint",
        "e2e": "playwright test --config=tests/e2e/playwright.config.ts",
        "visual": "node tests/e2e/visual/run.mjs",
        "lhci": "lhci autorun --config=tests/e2e/lighthouse/lighthouserc.cjs",
        "lhci:app": "lhci autorun --config=tests/e2e/lighthouse/lighthouserc.app-gate.cjs"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.14.0",
        "@lhci/cli": "^0.15.1",
        "@playwright/test": "^1.64.1",
        "@tailwindcss/vite": "^4.0.0",
        "@types/node": "^26.6.6",
        "@vitejs/plugin-vue": "^6.0.10",
        "@vue/eslint-config-typescript": "^14.9.0",
        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "eslint": "^10.14.0",
        "eslint-plugin-vue": "^10.12.0",
        "laravel-vite-plugin": "^2.0.0",
        "pixelmatch": "^8.0.0",
        "pngjs": "^7.0.0",
        "prettier": "^3.9.10",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "sharp": "^0.35.5",
        "tailwindcss": "^4.0.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.1",
        "vite": "^7.0.7",
        "vue-tsc": "^3.3.14"
    },
    "dependencies": {
        "@inertiajs/vue3": "^3.10.0",
        "@phosphor-icons/core": "^2.1.1",
        "@phosphor-icons/vue": "^2.2.1",
        "@tanstack/vue-table": "^9.3.1",
        "@vueuse/core": "^15.0.0",
        "chart.js": "^4.6.1",
        "date-fns": "^4.4.0",
        "laravel-echo": "^2.6.3",
        "laravel-vue-i18n": "^2.9.0",
        "pusher-js": "^8.6.0",
        "reka-ui": "^2.11.0",
        "vue": "^3.5.44",
        "vue-chartjs": "^5.3.4",
        "vue-sonner": "^2.0.9",
        "ziggy-js": "^2.6.5"
    },
    "name": "speedclub-web"
}
